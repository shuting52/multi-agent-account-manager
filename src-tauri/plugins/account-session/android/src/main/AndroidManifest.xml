<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application>
        <activity
            android:name="com.ldjx.accountmanager.AccountWebActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <activity
            android:name="com.ldjx.accountmanager.QrScannerActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
        <activity
            android:name="com.ldjx.accountmanager.ApkPickerActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- PackageInstaller 安装状态接收器：安装成功后自动拉起主界面。
             只收本应用显式发来的 PendingIntent（action 见
             InstallStatusReceiver.ACTION_INSTALL_STATUS），不对外暴露。 -->
        <receiver
            android:name="com.ldjx.accountmanager.InstallStatusReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.ldjx.accountmanager.INSTALL_STATUS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
